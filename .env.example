DATABASE_URL="postgresql://collegium_user:collegium_password@localhost:5432/collegium_dev?schema=public"

PORT=5000
# Must be "production" on the deployed server — gates secure/cross-site
# auth cookies (see auth.controller.ts) and the CORS/helmet posture.
NODE_ENV=development

FRONTEND_URL="http://localhost:3000"

JWT_SECRET="your_jwt_secret_here"
JWT_EXPIRES_IN="7d"

GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_CALLBACK_URL="http://localhost:5000/auth/google/callback"

CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name_here"
CLOUDINARY_API_KEY="your_cloudinary_api_key_here"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret_here"

BREVO_API_KEY="your_brevo_api_key_here"
# Must be a verified sender in Brevo.
EMAIL_FROM="your_verified_sender_email_here"

# OCR microservice (match screenshot stat scanning)
OCR_SERVICE_URL="http://localhost:8000"
# Must match the OCR service's own OCR_API_KEY in deployed environments.
OCR_API_KEY=
