generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ATHLETE
  NON_ATHLETE
  ADMIN
  ORGANIZER
}

enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum GameTitle {
  LOL
  VALORANT
  MLBB
  CODM
}

enum MatchMode {
  TOURNAMENT
  SCRIM
}

enum TournamentStatus {
  PENDING_APPROVAL
  UPCOMING
  ONGOING
  COMPLETED
  REJECTED
}

enum TournamentApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DataSource {
  API
  PEER_VERIFIED
}

enum TeamMemberStatus {
  ACCEPTED
  PENDING
  DECLINED
}

enum ScrimStatus {
  OPEN
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum NotificationCategory {
  SCRIM
  TEAM
  TOURNAMENT
}

enum NotificationType {
  SCRIM_REQUEST_RECEIVED
  SCRIM_REQUEST_ACCEPTED
  SCRIM_REQUEST_DECLINED
  SCRIM_UNBOOKED
  TEAM_JOIN_REQUEST
  TEAM_REQUEST_ACCEPTED
  TEAM_REQUEST_DECLINED
  TOURNAMENT_APPROVED
  TOURNAMENT_REJECTED
}

model University {
  id            String                 @id @default(uuid())
  name          String
  domain        String                 @unique
  glicko2_rating Float                 @default(1500)
  glicko2_rd     Float                 @default(350)
  glicko2_sigma  Float                 @default(0.06)
  created_at    DateTime               @default(now())
  users         User[]
  teams         Team[]
  tournaments   Tournament[]
  wonMatches    Match[]                @relation("MatchWinner")
  lostMatches   Match[]                @relation("MatchLoser")
  gameRatings   UniversityGameRating[]
  playerStats   PlayerStat[]
  tournamentApplications TournamentApplication[]
}

model UniversityGameRating {
  id             String    @id @default(uuid())
  universityId   String
  university     University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  gameTitle      GameTitle
  glicko2_rating Float     @default(1500)
  glicko2_rd     Float     @default(350)
  glicko2_sigma  Float     @default(0.06)
  wins           Int       @default(0)
  losses         Int       @default(0)
  updatedAt      DateTime  @updatedAt

  @@unique([universityId, gameTitle])
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  password       String?
  role           Role           @default(NON_ATHLETE)
  status         AccountStatus  @default(PENDING)
  emailVerified  Boolean        @default(false)
  displayName    String
  universityId   String
  university     University     @relation(fields: [universityId], references: [id])
  captainTeams   Team[]         @relation("TeamCaptain")
  teamMemberships TeamMember[]
  playerStats    PlayerStat[]
  refreshTokens  RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  notifications  Notification[]
  scrimChatMessages ScrimChatMessage[]
  organizedTournaments Tournament[] @relation("TournamentOrganizer")
  tournamentApplications TournamentApplication[]
  gameHandles    UserGameHandle[]
  createdAt      DateTime       @default(now())
}

model Team {
  id              String       @id @default(uuid())
  name            String
  gameTitle       GameTitle
  universityId    String
  university      University   @relation(fields: [universityId], references: [id])
  captainId       String
  captain         User         @relation("TeamCaptain", fields: [captainId], references: [id])
  inviteCode      String       @unique
  createdAt       DateTime     @default(now())
  members         TeamMember[]
  hostedScrims    Scrim[]      @relation("ScrimHost")
  acceptedScrims  Scrim[]      @relation("ScrimOpponent")
  tournamentApplications TournamentApplication[]
}

model TeamMember {
  id            String           @id @default(uuid())
  teamId        String
  team          Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameHandle    String
  preferredRole String?
  status        TeamMemberStatus @default(ACCEPTED)
  joinedAt      DateTime         @default(now())

  @@unique([teamId, userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Scrim {
  id            String      @id @default(uuid())
  teamId        String
  team          Team        @relation("ScrimHost", fields: [teamId], references: [id], onDelete: Cascade)
  gameTitle     GameTitle
  scheduledAt   DateTime
  format        String
  rankRange     String?
  mapPreference String?
  notes         String?
  status        ScrimStatus @default(OPEN)
  opponentId    String?
  opponent      Team?       @relation("ScrimOpponent", fields: [opponentId], references: [id])
  createdAt     DateTime    @default(now())
  chatMessages  ScrimChatMessage[]
}

model ScrimChatMessage {
  id         String   @id @default(uuid())
  scrimId    String
  scrim      Scrim    @relation(fields: [scrimId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderName String
  teamName   String
  text       String
  createdAt  DateTime @default(now())

  @@index([scrimId, createdAt])
}

model Match {
  id           String       @id @default(uuid())
  riotMatchId  String?      @unique
  title        GameTitle
  matchMode    MatchMode
  gameDuration Int
  gameMode     String
  platformId   String
  isVerified   Boolean      @default(false)
  playedAt     DateTime     @default(now())
  playerStats  PlayerStat[]
  winnerId     String?
  winner       University?  @relation("MatchWinner", fields: [winnerId], references: [id])
  loserId      String?
  loser        University?  @relation("MatchLoser", fields: [loserId], references: [id])
  tournamentId String?
  tournament   Tournament?  @relation(fields: [tournamentId], references: [id])
  // Bracket position within a tournament. round 0 = round-robin group stage;
  // round 1+ = single-elim rounds, playoff rounds, or double-elim WB/LB rounds.
  round        Int          @default(1)
  bracketSide  BracketSide?
}

// Only set for Double Elimination matches. Null for single-elim, round-robin,
// and playoff matches (they have one implicit bracket).
enum BracketSide {
  WINNERS
  LOSERS
  GRAND_FINAL
}

model Tournament {
  id              String           @id @default(uuid())
  name            String
  status          TournamentStatus @default(UPCOMING)
  gameTitle       GameTitle?
  image           String?
  imagePublicId   String?
  bracketFormat   String?
  teamQuota       Int?
  rules           String?
  startDate       DateTime?
  organizerId     String?
  organizer       User?            @relation("TournamentOrganizer", fields: [organizerId], references: [id])
  rejectionReason String?
  createdAt       DateTime         @default(now())
  matches         Match[]
  universities    University[]
  applications    TournamentApplication[]
}

model TournamentApplication {
  id            String                      @id @default(uuid())
  tournamentId  String
  tournament    Tournament                  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  universityId  String
  university    University                  @relation(fields: [universityId], references: [id])
  userId        String
  user          User                        @relation(fields: [userId], references: [id])
  applicantName String
  status        TournamentApplicationStatus @default(PENDING)
  teamId        String?
  team          Team?                       @relation(fields: [teamId], references: [id])
  teamName      String?
  appliedAt     DateTime                    @default(now())

  @@unique([tournamentId, userId])
  @@index([tournamentId])
}

model PlayerStat {
  id                          String              @id @default(uuid())
  matchId                     String
  match                       Match               @relation(fields: [matchId], references: [id])
  userId                      String?
  user                        User?               @relation(fields: [userId], references: [id])
  // Which side of the match this stat row belongs to — set for manually
  // (PEER_VERIFIED) entered stats, where the Riot-specific numeric teamId
  // below doesn't apply.
  universityId                String?
  university                  University?         @relation(fields: [universityId], references: [id])
  puuid                       String?
  summonerName                String
  championName                String?
  kills                       Int
  deaths                      Int
  assists                     Int
  role                        String?
  lane                        String?
  totalDamageDealt            Int?
  totalDamageDealtToChampions Int?
  visionScore                 Int?
  objectivesStolen            Int?
  turretKills                 Int?
  inhibitorKills              Int?
  win                         Boolean
  teamId                      Int?
  vcsScore                    Float?
  dataSource                  DataSource          @default(API)
  extraStats                  Json?
  createdAt                   DateTime            @default(now())
  valorantStat                ValorantPlayerStat?
}

model Notification {
  id        String               @id @default(uuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  NotificationCategory
  type      NotificationType
  title     String
  message   String
  link      String?
  refId     String?
  read      Boolean              @default(false)
  createdAt DateTime             @default(now())

  @@index([userId, read])
}

model ValorantPlayerStat {
  id           String     @id @default(uuid())
  playerStatId String     @unique
  playerStat   PlayerStat @relation(fields: [playerStatId], references: [id])
  agentName    String?
  combatScore  Int?
  headshotPct  Float?
  plants       Int?
  defuses      Int?
  firstBloods  Int?
  damageDealt  Int?
  createdAt    DateTime   @default(now())
}

model UserGameHandle {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameTitle GameTitle
  handle    String
  updatedAt DateTime  @updatedAt

  @@unique([userId, gameTitle])
}

